SEARCH_ASSISTANT_DATA_DIR=.local-data
SEARCH_ASSISTANT_DATABASE_PATH=
SEARCH_ASSISTANT_FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Model providers are OpenAI-compatible endpoints handled by the Pydantic AI runtime.
# SEARCH_ASSISTANT_MODEL_PROVIDER selects a model provider, not an agent framework.
SEARCH_ASSISTANT_MODEL_PROVIDER=glm
SEARCH_ASSISTANT_ALLOW_FAKE_RUNTIME=false
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4.7
GLM_TIMEOUT_SECONDS=120
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
# Briefing synthesis gets a longer timeout than general calls: 25+ sources
# regularly take 60-70s, and a synthesis timeout silently degrades the whole
# report to deterministic fallback templates (fixed detailed-summary headings).
# Raise this if very large briefings still fall back.
BRIEFING_SYNTHESIS_TIMEOUT_SECONDS=120
SEARCH_ASSISTANT_SEARCH_PROVIDER=hybrid
SEARCH_ASSISTANT_MCP_SEARCH_CONFIG=
MCP_SEARCH_TIMEOUT_SECONDS=18
# Agent Reach is an optional read-only CLI router. Enable only after
# `agent-reach doctor --json` shows usable backends: general web needs
# mcporter + Exa MCP, GitHub needs gh CLI, YouTube needs yt-dlp with a JS
# runtime. Unconfigured routes return empty and the hybrid provider falls back
# to MCP/browser search. See docs/configuration.md#optional-agent-reach-install.
SEARCH_ASSISTANT_AGENT_REACH_ENABLED=false
AGENT_REACH_COMMAND=agent-reach
AGENT_REACH_TIMEOUT_SECONDS=30
AGENT_REACH_DOCTOR_CACHE_SECONDS=300
RSSHUB_BASE_URL=http://127.0.0.1:1200
SEARCH_ASSISTANT_DOMESTIC_RSS_CONFIG=
DOMESTIC_RSS_TIMEOUT_SECONDS=8
BROWSER_SEARCH_ENGINES=bing,baidu,google
BROWSER_SEARCH_BASE_URL=https://cn.bing.com/search
BROWSER_SEARCH_MARKET=zh-CN
BROWSER_SEARCH_TIMEOUT_SECONDS=8
BROWSER_CONTENT_TIMEOUT_SECONDS=3
BROWSER_ENRICH_MAX_RESULTS=2
WORKFLOW_SEARCH_BUDGET_SECONDS=45
BRIEFING_SEARCH_BUDGET_SECONDS=90
BRIEFING_PLANNING_TIMEOUT_SECONDS=40
BRIEFING_MAX_QUERIES=28
BAIDU_SEARCH_BASE_URL=https://www.baidu.com/baidu
GOOGLE_SEARCH_BASE_URL=https://www.google.com/search
BRIEFING_RESULTS_PER_QUERY=10
BRIEFING_MAX_SOURCES=50
BRIEFING_MODEL_MAX_SOURCES=12
BRIEFING_TIMEZONE=Asia/Shanghai
SEARCH_ASSISTANT_ADMIN_USER_IDS=
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
SEARXNG_BASE_URL=http://localhost:8080/search
SEARXNG_TIMEOUT_SECONDS=12
BILIBILI_SEARCH_BASE_URL=https://api.bilibili.com/x/web-interface/search/type
DUCKDUCKGO_TIMEOUT_SECONDS=12

# Optional: enable cross-lingual semantic matching for knowledge graphs.
# The embedding provider uses an OpenAI-compatible API. It first reads
# OPENAI_API_KEY / OPENAI_BASE_URL; if those are empty, it falls back to
# DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL (e.g. for DeepSeek-compatible endpoints
# or third-party proxies that expose embedding models). Without any key the
# service falls back to literal matching only.
SEARCH_ASSISTANT_EMBEDDING_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
